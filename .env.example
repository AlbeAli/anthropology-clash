# Umami (analytics senza cookie). I valori di produzione sono in .env.production:
# il Website ID non è un segreto, compare nell'HTML di ogni pagina pubblicata.
# In sviluppo (pnpm dev) nessuno script viene caricato.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=

# Supabase (M10, account facoltativo). URL del progetto e chiave pubblicabile
# (sb_publishable_...): pubbliche per costruzione, finiscono nel bundle; la
# protezione dei dati sta nelle regole RLS. Mai la chiave service_role.
# Senza questi valori l'app funziona senza account.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
